{
  "name": "larder",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "description": "Realtime household grocery list — installable PWA with Siri support",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
